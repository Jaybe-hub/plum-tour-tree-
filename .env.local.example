# Copy this file to .env.local and fill in your real Sanity project values.
# Find these at https://www.sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Same three values again, with a different prefix — required separately by
# the standalone Sanity Studio tool (npx sanity dev). Use the exact same
# values as above.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2025-01-01

# Optional but recommended for the Live Content API. Create a Viewer token at
# https://www.sanity.io/manage under API > Tokens.
SANITY_API_READ_TOKEN=
